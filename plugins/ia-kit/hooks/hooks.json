{
  "description": "Garde PROJET.md à jour (modifications manuelles rattrapées en début de conversation, PROJET.md suivi après chaque demande qui modifie le projet), prévient les agents back, front et auditeur quand leur contexte devient trop lourd, rappelle à Claude de noter ses erreurs quand un message ressemble à une correction, rappelle le ménage mensuel de la mémoire, et demande confirmation avant de lancer un agent ia-kit sur le même modèle que la conversation.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/reperage-erreurs.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/meme-modele.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/surveillance-contexte.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/rappel-menage.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/templates/commun/.husky/projet-sync.sh\" debut",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/templates/commun/.husky/projet-sync.sh\" fin",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
