# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais versionné).
NODE_ENV=development
PORT=3000
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgres://utilisateur@localhost:5432/__NOM_PROJET__
# Adresse du front autorisée à appeler l'API
CORS_ORIGIN=http://localhost:5173
