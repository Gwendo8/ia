{
  "name": "__NOM_PROJET__-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "pretest": "node scripts/db-migrate-test.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "node scripts/db-migrate-test.js",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:test": "NODE_ENV=test sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:new": "node scripts/db-new.js"
  },
  "dependencies": {
    "cors": "^2.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.0.0",
    "pg-hstore": "^2.0.0",
    "sequelize": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.0.0",
    "sequelize-cli": "^6.0.0",
    "supertest": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
